{
  "id": "queue-overflow",
  "title": "Queue overflow",
  "type": "burst_load",
  "description": "worker와 queue 수용량을 초과하는 burst에서 일부 요청은 안전하게 거절되어야 한다.",
  "sql": "SELECT * FROM student;",
  "concurrency_multiplier": 1,
  "burst_extra": 4,
  "mock_sleep_ms": 800,
  "request_timeout_sec": 3.0,
  "expect": {
    "allowed_statuses": [200, 400, 429, 500, 503],
    "overload_statuses": [429, 503],
    "require_overload": true,
    "server_alive_after": true
  }
}
