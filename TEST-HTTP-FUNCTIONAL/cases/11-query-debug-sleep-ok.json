{
  "name": "query_debug_sleep_ok",
  "description": "POST /query accepts a valid X-Debug-Sleep-Ms header and still returns a normal success payload",
  "request": {
    "method": "POST",
    "path": "/query",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "text/plain; charset=utf-8",
      "X-Debug-Sleep-Ms": "300"
    },
    "rawBody": "SELECT name FROM student WHERE id = 1;"
  },
  "expect": {
    "statusCode": 200,
    "contentTypeContains": "application/json",
    "requiredFields": [
      "ok",
      "path",
      "status_code",
      "message",
      "affected_rows",
      "output_text"
    ],
    "fieldTypes": {
      "ok": "boolean",
      "path": "string",
      "status_code": "integer",
      "message": "string",
      "affected_rows": "integer",
      "output_text": "string"
    },
    "fieldEquals": {
      "ok": true,
      "path": "/query",
      "status_code": 200
    },
    "fieldContains": {
      "message": "SELECT",
      "output_text": "name_1"
    },
    "fieldNonEmpty": [
      "message",
      "output_text"
    ],
    "minDurationMs": 250,
    "maxDurationMs": 2000
  }
}
