{
  "name": "query_invalid_debug_sleep_header",
  "description": "POST /query rejects an invalid X-Debug-Sleep-Ms header value",
  "request": {
    "method": "POST",
    "path": "/query",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "text/plain; charset=utf-8",
      "X-Debug-Sleep-Ms": "30000"
    },
    "rawBody": "SELECT name FROM student WHERE id = 1;"
  },
  "expect": {
    "statusCode": 400,
    "contentTypeContains": "application/json",
    "requiredFields": [
      "ok",
      "path",
      "status_code",
      "error_code",
      "message"
    ],
    "fieldTypes": {
      "ok": "boolean",
      "path": "string",
      "status_code": "integer",
      "error_code": "string",
      "message": "string"
    },
    "fieldEquals": {
      "ok": false,
      "path": "/query",
      "status_code": 400,
      "error_code": "invalid_header"
    },
    "fieldContains": {
      "message": "X-Debug-Sleep-Ms"
    },
    "fieldNonEmpty": [
      "message"
    ]
  }
}
