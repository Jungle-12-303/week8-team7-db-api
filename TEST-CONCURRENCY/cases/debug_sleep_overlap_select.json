{
  "name": "debug-sleep-overlap-select",
  "description": "X-Debug-Sleep-Ms 지연이 worker별로 겹치는지 확인해 API 계층 overlap을 시연한다.",
  "target": {
    "base_url_env": "DB_SERVER_URL",
    "health_path": "/health",
    "query_path": "/query",
    "headers": {
      "Content-Type": "text/plain; charset=utf-8"
    },
    "body_template": "{{sql}}"
  },
  "phases": [
    {
      "name": "sequential-debug-sleep",
      "mode": "sequential",
      "requests": [
        {
          "name": "sleep-select-id-1",
          "headers": {
            "X-Debug-Sleep-Ms": "500"
          },
          "sql": "SELECT name FROM student WHERE id = 1;",
          "expect": {
            "status": 200,
            "json_equals": [
              {
                "path": "ok",
                "equals": true
              }
            ],
            "json_string_contains": [
              {
                "path": "output_text",
                "substring": "name_1"
              }
            ]
          }
        },
        {
          "name": "sleep-select-id-2",
          "headers": {
            "X-Debug-Sleep-Ms": "500"
          },
          "sql": "SELECT name FROM student WHERE id = 2;",
          "expect": {
            "status": 200,
            "json_equals": [
              {
                "path": "ok",
                "equals": true
              }
            ],
            "json_string_contains": [
              {
                "path": "output_text",
                "substring": "name_2"
              }
            ]
          }
        },
        {
          "name": "sleep-select-id-3",
          "headers": {
            "X-Debug-Sleep-Ms": "500"
          },
          "sql": "SELECT name FROM student WHERE id = 3;",
          "expect": {
            "status": 200,
            "json_equals": [
              {
                "path": "ok",
                "equals": true
              }
            ],
            "json_string_contains": [
              {
                "path": "output_text",
                "substring": "name_3"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "concurrent-debug-sleep",
      "mode": "concurrent",
      "max_workers": 3,
      "requests": [
        {
          "name": "sleep-select-id-1",
          "headers": {
            "X-Debug-Sleep-Ms": "500"
          },
          "sql": "SELECT name FROM student WHERE id = 1;",
          "expect": {
            "status": 200,
            "json_equals": [
              {
                "path": "ok",
                "equals": true
              }
            ],
            "json_string_contains": [
              {
                "path": "output_text",
                "substring": "name_1"
              }
            ]
          }
        },
        {
          "name": "sleep-select-id-2",
          "headers": {
            "X-Debug-Sleep-Ms": "500"
          },
          "sql": "SELECT name FROM student WHERE id = 2;",
          "expect": {
            "status": 200,
            "json_equals": [
              {
                "path": "ok",
                "equals": true
              }
            ],
            "json_string_contains": [
              {
                "path": "output_text",
                "substring": "name_2"
              }
            ]
          }
        },
        {
          "name": "sleep-select-id-3",
          "headers": {
            "X-Debug-Sleep-Ms": "500"
          },
          "sql": "SELECT name FROM student WHERE id = 3;",
          "expect": {
            "status": 200,
            "json_equals": [
              {
                "path": "ok",
                "equals": true
              }
            ],
            "json_string_contains": [
              {
                "path": "output_text",
                "substring": "name_3"
              }
            ]
          }
        }
      ]
    }
  ],
  "assertions": [
    {
      "type": "phase_requests_success",
      "phase": "sequential-debug-sleep"
    },
    {
      "type": "phase_requests_success",
      "phase": "concurrent-debug-sleep"
    },
    {
      "type": "phase_has_overlap",
      "phase": "concurrent-debug-sleep"
    },
    {
      "type": "start_spread_at_most",
      "phase": "concurrent-debug-sleep",
      "max_start_spread_ms": 150.0
    },
    {
      "type": "concurrent_shorter_or_overlap",
      "phase": "concurrent-debug-sleep",
      "baseline": "sequential-debug-sleep",
      "max_ratio": 0.9
    }
  ]
}
